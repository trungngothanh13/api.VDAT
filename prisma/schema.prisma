datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  POLICE
  ADMIN
}

enum ViolationStatus {
  PENDING_REVIEW
  CONFIRMED
  DISMISSED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  role         Role        @default(POLICE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  violations   Violation[]

  @@map("users")
}

model ZoneProfile {
  id               String      @id @default(uuid())
  sourceKey        String      @unique // e.g. "file:test_1.mp4", "webcam:default", "camera:cam-01"
  name             String
  lanes            Json        // Approach Lane polygons: [[[x,y], ...], ...]
  intersection     Json        // Intersection polygon: [[x,y], ...]
  exitZones        Json        @default("[]") // Exit Zone polygons: [[[x,y], ...], ...]
  lightBox         Json?       // Traffic light sampling boxes: [{x, y, color}]
  crossingMode     Boolean     @default(false) // 3/4-way multi-lane crossing mode toggle
  clearanceSeconds Float       @default(3.0)
  version          Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  cameras          Camera[]
  violations       Violation[]

  @@map("zone_profiles")
}

model Camera {
  id                  String       @id // e.g. "cam-01"
  name                String
  location            String
  rtspUrl             String?
  isActive            Boolean      @default(false)
  lastSeenAt          DateTime?
  activeSourceKey     String?
  activeZoneProfileId String?
  activeZoneProfile   ZoneProfile? @relation(fields: [activeZoneProfileId], references: [id], onDelete: SetNull)
  metadata            Json?        // { fps, width, height, tracker, model }
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  violations          Violation[]

  @@map("cameras")
}

model Violation {
  id              String          @id @default(uuid())
  cameraId        String
  camera          Camera          @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  zoneProfileId   String?
  zoneProfile     ZoneProfile?    @relation(fields: [zoneProfileId], references: [id], onDelete: SetNull)
  sourceKey       String?
  trackId         Int
  vehicleClass    String          // e.g. "motorcycle", "car"
  classId         Int
  frameNumber     Int
  timestamp       String          // e.g. "19.97s"
  lightState      String          // "red"
  bbox            Json            // [x1, y1, x2, y2]
  confidence      Float?
  snapshotUrl     String?         // Path / URL to JPG evidence thumbnail
  evidenceClipUrl String?         // Path / URL to MP4 proof clip
  status          ViolationStatus @default(PENDING_REVIEW)
  reviewedById    String?
  reviewedBy      User?           @relation(fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([cameraId])
  @@index([status])
  @@index([createdAt])
  @@map("violations")
}
